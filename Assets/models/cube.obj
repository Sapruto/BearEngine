# Cube
mtllib cube.mtl
o Cube

# 8 позиций (общие)
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# 6 нормалей
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0

# 4 UV на грань (одинаковые для всех граней, 0..1)
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# Передняя грань (-Z), нормаль 1
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1

# Задняя грань (+Z), нормаль 2
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2

# Левая грань (-X), нормаль 3
f 1/1/3 5/2/3 8/3/3
f 1/1/3 8/3/3 4/4/3

# Правая грань (+X), нормаль 4
f 2/1/4 3/2/4 7/3/4
f 2/1/4 7/3/4 6/4/4

# Нижняя грань (-Y), нормаль 5
f 1/1/5 2/2/5 6/3/5
f 1/1/5 6/3/5 5/4/5

# Верхняя грань (+Y), нормаль 6
f 4/1/6 8/2/6 7/3/6
f 4/1/6 7/3/6 3/4/6